<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>RT – Case – Route and Alert. After-save, Create only. Entry criteria: Priority = Urgent. Sends email alert to queue supervisor, marks Urgent_Alert_Sent__c = true. Fault path logs CaseComment. IPOP-4/9/18.</description>
    <environments>Default</environments>
    <interviewLabel>Case After Create Route And Alert {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RT – Case – Route and Alert</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Send_Urgent_Alert</targetReference>
        </connector>
        <filterLogic>1</filterLogic>
        <filters>
            <field>Priority</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Urgent</stringValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <actionCalls>
        <description>Sends an email alert to the queue supervisor when an Urgent intake case is created. IPOP-9/18.</description>
        <name>Send_Urgent_Alert</name>
        <label>Send Urgent Alert Email</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <actionName>Case.Crestview_Urgent_Case_Alert</actionName>
        <actionType>emailAlert</actionType>
        <connector>
            <targetReference>Update_Urgent_Alert_Sent</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Alert_Fault</targetReference>
        </faultConnector>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
    <recordCreates>
        <description>Fault path: if the email alert fails, log a CaseComment so staff know the alert was not sent.</description>
        <name>Log_Alert_Fault</name>
        <label>Log Alert Failure as Case Comment</label>
        <locationX>352</locationX>
        <locationY>240</locationY>
        <inputAssignments>
            <field>ParentId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CommentBody</field>
            <value>
                <stringValue>SYSTEM ALERT: Urgent case alert email failed to send. Notify the queue supervisor manually. Fault: {!$Flow.FaultMessage}</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>IsPublished</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>CaseComment</object>
    </recordCreates>
    <recordUpdates>
        <description>Marks Urgent_Alert_Sent__c = true after the alert email is sent. IPOP-18.</description>
        <name>Update_Urgent_Alert_Sent</name>
        <label>Set Urgent Alert Sent to True</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <faultConnector>
            <targetReference>Log_Alert_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Urgent_Alert_Sent__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
</Flow>
