<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>RT – Case – Subject Fill. Before-save record-triggered flow on Case (create and update). Auto-fills the Subject field with "[Patient Full Name] — [Today's Date]" when Subject is blank. Runs before record is saved so no extra DML is needed. IPOP-3.</description>
    <environments>Default</environments>
    <formulas>
        <description>Builds the default subject using the contact's full name and today's date.</description>
        <name>forT_DefaultSubject</name>
        <dataType>String</dataType>
        <expression>$Record.Contact.Name &amp; " — " &amp; TEXT(TODAY())</expression>
    </formulas>
    <interviewLabel>Case Before Save Subject Fill {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RT – Case – Subject Fill</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordTriggerType>CreateAndUpdate</recordTriggerType>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <filterLogic>1</filterLogic>
        <filters>
            <field>Subject</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <assignments>
        <description>Sets the Subject field on the in-memory record to the computed default value. No DML needed in before-save context.</description>
        <name>Set_Subject_to_Default</name>
        <label>Set Subject to Default</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignmentItems>
            <assignToReference>$Record.Subject</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>forT_DefaultSubject</elementReference>
            </value>
        </assignmentItems>
    </assignments>
</Flow>
