<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>RT – Case – Re-Route and Alert. After-save, Update. Entry criteria: Type field changed. Logs success CaseComment (Part-A item 2 IPOP-6), sends re-route notification email. Fault path logs CaseComment.</description>
    <environments>Default</environments>
    <formulas>
        <description>Builds the re-route comment body documenting the type change.</description>
        <name>forT_ReRouteComment</name>
        <dataType>String</dataType>
        <expression>"SYSTEM: Case type changed from '" &amp; TEXT($Record__Prior.Type) &amp; "' to '" &amp; TEXT($Record.Type) &amp; "' on " &amp; TEXT(TODAY()) &amp; ". Case re-routed via assignment rules."</expression>
    </formulas>
    <interviewLabel>Case After Update Re Route And Alert {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RT – Case – Re-Route and Alert</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Log_ReRoute_Success</targetReference>
        </connector>
        <filterLogic>1</filterLogic>
        <filters>
            <field>Type</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <actionCalls>
        <description>Sends email notification to the new queue informing them of the re-routed case.</description>
        <name>Send_ReRoute_Notification</name>
        <label>Send Re-Route Notification Email</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <actionName>Case.Crestview_Case_ReRoute_Notification</actionName>
        <actionType>emailAlert</actionType>
        <faultConnector>
            <targetReference>Log_ReRoute_Fault</targetReference>
        </faultConnector>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
    <recordCreates>
        <description>Success path: logs a CaseComment documenting the type change and re-route. Part-A item 2 (IPOP-6).</description>
        <name>Log_ReRoute_Success</name>
        <label>Log Re-Route Success as Case Comment</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <connector>
            <targetReference>Send_ReRoute_Notification</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_ReRoute_Fault</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>ParentId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CommentBody</field>
            <value>
                <elementReference>forT_ReRouteComment</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>IsPublished</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>CaseComment</object>
    </recordCreates>
    <recordCreates>
        <description>Fault path: logs a CaseComment when the re-route notification or success log fails.</description>
        <name>Log_ReRoute_Fault</name>
        <label>Log Re-Route Failure as Case Comment</label>
        <locationX>352</locationX>
        <locationY>240</locationY>
        <inputAssignments>
            <field>ParentId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CommentBody</field>
            <value>
                <stringValue>SYSTEM ALERT: Case re-route notification failed. Please check manually. Fault: {!$Flow.FaultMessage}</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>IsPublished</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>CaseComment</object>
    </recordCreates>
</Flow>
