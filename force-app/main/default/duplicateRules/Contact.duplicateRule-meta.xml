<?xml version="1.0" encoding="UTF-8"?>
<DuplicateRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionOnInsert>Allow</actionOnInsert>
    <actionOnUpdate>Allow</actionOnUpdate>
    <alertOnInsert>true</alertOnInsert>
    <alertOnUpdate>true</alertOnUpdate>
    <description>Duplicate rule for Crestview patient records. Alert mode — allows save but shows warning to the user. References Patient_Duplicate_Match matching rule. Settled as ALERT mode per Bobby's decision (OQ-2). IPOP-13.</description>
    <duplicateRuleFilter>
        <booleanFilter></booleanFilter>
        <duplicateRuleFilterItems>
        </duplicateRuleFilterItems>
    </duplicateRuleFilter>
    <duplicateRuleMatchRules>
        <matchRuleSourceObjectMapping>Contact</matchRuleSourceObjectMapping>
        <matchingRule>Contact.Patient_Duplicate_Match</matchingRule>
        <objectMapping>
            <fieldMappings>
                <fieldName>FirstName</fieldName>
                <mappingType>CurrentField</mappingType>
            </fieldMappings>
            <fieldMappings>
                <fieldName>LastName</fieldName>
                <mappingType>CurrentField</mappingType>
            </fieldMappings>
            <fieldMappings>
                <fieldName>Birthdate</fieldName>
                <mappingType>CurrentField</mappingType>
            </fieldMappings>
        </objectMapping>
    </duplicateRuleMatchRules>
    <isActive>true</isActive>
    <label>Patient Duplicate Block</label>
    <operationsOnInsert>Alert</operationsOnInsert>
    <operationsOnUpdate>Alert</operationsOnUpdate>
    <securityOption>EnforceSharingRules</securityOption>
    <sortOrder>1</sortOrder>
</DuplicateRule>
