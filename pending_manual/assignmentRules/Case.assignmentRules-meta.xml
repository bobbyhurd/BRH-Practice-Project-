                <value>Counseling</value>
            </criteriaItems>
            <order>2</order>
            <rerunOnEdit>true</rerunOnEdit>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>Medical_Response_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Case.Type</field>
                <operation>equals</operation>
                <value>Medical</value>
            </criteriaItems>
            <order>3</order>
            <rerunOnEdit>true</rerunOnEdit>
        </ruleEntry>
    </rules>
</AssignmentRules>
