<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Case_Cross_Team_Read</fullName>
        <accessLevel>Read</accessLevel>
        <criteriaItems>
            <field>Status</field>
            <operation>notEqual</operation>
            <value>Draft</value>
        </criteriaItems>
        <description>Shares non-Draft cases with all internal users for cross-team visibility. ADR-005. IPOP-5.</description>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
        <label>Case Cross Team Read</label>
        <sharedTo>
            <allInternalUsers>allInternalUsers</allInternalUsers>
        </sharedTo>
    </sharingCriteriaRules>
</SharingRules>
