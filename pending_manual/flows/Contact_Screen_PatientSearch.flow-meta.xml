<?xml version='1.0' encoding='UTF-8'?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">

    <assignments>
        <description>Captures the ID of the newly created Case record into varT_CaseId for use on the confirmation screen.</description>
        <name>Set_Case_Id</name>
        <label>Set Case ID</label>
        <locationX>176</locationX>
        <locationY>1100</locationY>
        <assignmentItems>
            <assignToReference>varT_CaseId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Create_Case</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_New_Case</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Captures the ID of the newly created Contact record into varT_ContactId for use in Case creation.</description>
        <name>Set_New_Contact_Id</name>
        <label>Set New Contact ID</label>
        <locationX>352</locationX>
        <locationY>620</locationY>
        <assignmentItems>
            <assignToReference>varT_ContactId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Create_New_Contact</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Screen_CaseDetails</targetReference>
        </connector>
    </assignments>

    
    <decisions>
        <description>Routes to search results screen if patients found; routes to new patient creation if none found.</description>
        <name>Decision_PatientFound</name>
        <label>Was a Patient Found?</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <defaultConnector>
            <targetReference>Screen_NewPatient</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Patient Found — Create New</defaultConnectorLabel>
        <rules>
            <name>Patient_Found_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varR_SearchResults</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_SelectPatient</targetReference>
            </connector>
            <label>Yes — Patient(s) Found</label>
        </rules>
    </decisions>

    
    <decisions>
        <description>If an existing patient was selected (ContactId is not null), proceed to case creation; otherwise create a new Contact.</description>
        <name>Decision_UseExistingOrNew</name>
        <label>Use Existing Patient or Create New?</label>
        <locationX>0</locationX>
        <locationY>600</locationY>
        <defaultConnector>
            <targetReference>Screen_NewPatient</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Create New Patient</defaultConnectorLabel>
        <rules>
            <name>Use_Existing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varT_ContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_CaseDetails</targetReference>
            </connector>
            <label>Use Existing Patient</label>
        </rules>
    </decisions>

    
    <description>SF – Contact Screen – Patient Search. Screen flow for the Crestview patient intake process. Guides intake coordinators through 5 steps: (1) patient search by name/phone/DOB, (2) create or update Contact record, (3) create Case with Status=Draft, (4) Save Draft or Submit, (5) confirmation. IPOP-3/4/10. ADR-006: Save Draft = explicit button that saves with Status=Draft; Submit = button that sets Status=Submitted and triggers assignment.</description>
    <dynamicChoiceSets>
        <description>Picklist choices for Case.Type standard picklist.</description>
        <name>picChoice_CaseType</name>
        <dataType>Picklist</dataType>
        <displayField>label</displayField>
        <object>Case</object>
        <picklistField>Type</picklistField>
        <valueField>value</valueField>
    </dynamicChoiceSets>

    <dynamicChoiceSets>
        <description>Picklist choices for Case.Priority standard picklist.</description>
        <name>picChoice_CasePriority</name>
        <dataType>Picklist</dataType>
        <displayField>label</displayField>
        <object>Case</object>
        <picklistField>Priority</picklistField>
        <valueField>value</valueField>
    </dynamicChoiceSets>

    
    <environments>Default</environments>
    <formulas>
        <description>Returns "Submitted" if the coordinator clicked Submit, otherwise "Draft".</description>
        <name>forT_CaseStatus</name>
        <dataType>String</dataType>
        <expression>IF({!varT_ActionChoice} = "Submit", "Submitted", "Draft")</expression>
    </formulas>

    
    <interviewLabel>Contact Screen Patient Search {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SF – Contact Screen – Patient Search</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>

    
    <recordCreates>
        <description>Creates the new patient Contact record with Is_Patient__c = true. Fault path routes to the fault screen.</description>
        <name>Create_New_Contact</name>
        <label>Create New Patient Contact</label>
        <locationX>352</locationX>
        <locationY>600</locationY>
        <connector>
            <targetReference>Set_New_Contact_Id</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_ErrorGeneric</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>FirstName</field>
            <value>
                <elementReference>varR_Contact.FirstName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>LastName</field>
            <value>
                <elementReference>varR_Contact.LastName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Phone</field>
            <value>
                <elementReference>varR_Contact.Phone</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Email</field>
            <value>
                <elementReference>varR_Contact.Email</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Birthdate</field>
            <value>
                <elementReference>varR_Contact.Birthdate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Is_Patient__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>

    
    <recordCreates>
        <description>Creates the Case record. Status is set to Draft or Submitted based on varB_Submit. ContactId links the patient. Fault path routes to the error screen.</description>
        <name>Create_Case</name>
        <label>Create Intake Case</label>
        <locationX>176</locationX>
        <locationY>1080</locationY>
        <connector>
            <targetReference>Set_Case_Id</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_ErrorGeneric</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>ContactId</field>
            <value>
                <elementReference>varT_ContactId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Type</field>
            <value>
                <elementReference>varR_Case.Type</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <elementReference>varR_Case.Priority</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>varR_Case.Description</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <elementReference>forT_CaseStatus</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>

    <recordLookups>
        <description>Queries Contact records matching the search criteria. Searches by LastName and/or Phone. Bulk-safe: LIMIT 50.</description>
        <name>Search_Existing_Patients</name>
        <label>Search Existing Patients</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_PatientFound</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>LastName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varT_SearchLastName</elementReference>
            </value>
        </filters>
        <filters>
            <field>Phone</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varT_SearchPhone</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <limit>50</limit>
        <object>Contact</object>
        <outputReference>varR_SearchResults</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>FirstName</queriedFields>
        <queriedFields>LastName</queriedFields>
        <queriedFields>Phone</queriedFields>
        <queriedFields>Birthdate</queriedFields>
        <queriedFields>Email</queriedFields>
        <queriedFields>Is_Patient__c</queriedFields>
        <sortField>LastName</sortField>
        <sortOrder>Asc</sortOrder>
    </recordLookups>

    
    <recordLookups>
        <description>Reads the CaseNumber of the newly created Case for display on the confirmation screen.</description>
        <name>Get_New_Case</name>
        <label>Get New Case Number</label>
        <locationX>176</locationX>
        <locationY>1200</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Screen_Confirmation</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Confirmation</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varT_CaseId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <outputAssignments>
            <assignToReference>varT_CaseNumber</assignToReference>
            <field>CaseNumber</field>
        </outputAssignments>
        <queriedFields>Id</queriedFields>
        <queriedFields>CaseNumber</queriedFields>
    </recordLookups>

    
    <screens>
        <description>Screen 1: Intake coordinator enters patient search criteria (Last Name, Phone, or DOB) to look up an existing patient before creating a new Contact.</description>
        <name>Screen_PatientSearch</name>
        <label>Step 1 of 5: Search for Patient</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Search_Existing_Patients</targetReference>
        </connector>
        <fields>
            <name>CPS_SearchInstruction</name>
            <fieldText>&lt;p&gt;Enter one or more search criteria below to find an existing patient record before creating a new one.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>CPS_LastName</name>
            <dataType>String</dataType>
            <fieldText>Last Name</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <outputParameters>
                <assignToReference>varT_SearchLastName</assignToReference>
                <name>value</name>
            </outputParameters>
        </fields>
        <fields>
            <name>CPS_Phone</name>
            <dataType>String</dataType>
            <fieldText>Phone Number</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <outputParameters>
                <assignToReference>varT_SearchPhone</assignToReference>
                <name>value</name>
            </outputParameters>
        </fields>
        <fields>
            <name>CPS_DOB</name>
            <dataType>Date</dataType>
            <fieldText>Date of Birth</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <outputParameters>
                <assignToReference>varD_SearchDOB</assignToReference>
                <name>value</name>
            </outputParameters>
        </fields>
        <nextOrFinishButtonLabel>Search</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>

    
    <screens>
        <description>Screen 2a: Shows search results. Coordinator selects an existing patient or clicks "Create New Patient" to start a new record.</description>
        <name>Screen_SelectPatient</name>
        <label>Step 2 of 5: Select or Create Patient</label>
        <locationX>0</locationX>
        <locationY>480</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Decision_UseExistingOrNew</targetReference>
        </connector>
        <fields>
            <name>SPS_ResultsHeader</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Patient search results. Select a patient to use for this intake, or choose "Create New Patient" below.&lt;/b&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>SPS_PatientId</name>
            <dataType>String</dataType>
            <fieldText>Patient Contact ID (copy from search results above)</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <outputParameters>
                <assignToReference>varT_ContactId</assignToReference>
                <name>value</name>
            </outputParameters>
        </fields>
        <fields>
            <name>SPS_CreateNew</name>
            <fieldText>&lt;p&gt;Don't see the patient? Leave the dropdown blank and click Next to create a new patient record.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <nextOrFinishButtonLabel>Next</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>

    <screens>
        <description>Screen 2b: Coordinator enters details for a new patient Contact record (FirstName, LastName, Phone, Email, DOB, marks as patient).</description>
        <name>Screen_NewPatient</name>
